// Аномалии (V6). ЧИСЛА ВРЕМЕННЫЕ: причины и механизмы отдельных аномалий —
// открытый вопрос концепта; здесь только то, что нужно прототипу.
//
//   kind            — Gravity (другие виды добавляются в код anomaly::effects);
//   modes           — режимы генератора: (название, множитель силы тяжести);
//                     1.0 — обычная, 0.0 — невесомость, < 0 — тянет вверх;
//   radii           — радиусы, которые можно выставить на генераторе (м);
//   form_time       — секунд работы с топливом, чтобы сформировать аномалию;
//   success         — вероятность успеха в едва подходящей среде (в среде
//                     вдвое нестабильнее — 100 %);
//   min_instability — минимальная сила нестабильного поля (раздражённая,
//                     конденсированная или уникальная магия) у генератора;
//   spread          — разброс результата относительно настройки (доля);
//   jitter          — насколько «гуляет» неудерживаемая аномалия (доля
//                     её отклонения от обычной силы тяжести);
//   persist_chance  — вероятность, что аномалия останется после остановки
//                     генератора; persist_time — сколько она тогда живёт (с).
// Мод может добавить mods/<мод>/content/anomalies.ron.
[
    (key: "gravity", name: "Гравитационная аномалия", kind: Gravity,
     modes: [("Лёгкость", 0.35), ("Невесомость", 0.0), ("Обратная тяга", -0.6), ("Тяжесть", 2.2)],
     radii: [4.0, 6.0, 9.0, 12.0],
     form_time: 6.0, success: 0.7, min_instability: 1.5, spread: 0.25, jitter: 0.5,
     persist_chance: 0.5, persist_time: (60.0, 240.0)),
]
