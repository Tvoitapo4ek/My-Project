// Item descriptions for the inventory tooltip: (key, short, long).
// Short: on hover. Long: hold Shift. Hold W over an item: the visual
// explanation (ponder), if it has one.
[
    // ---- building
    ("white_block", "Простой белый строительный блок.", "Строительный блок без механики. Как и любой строительный блок, ставится в шести формах: Shift + колесо — куб, плита, ступенька, скос, внешний и внутренний угол."),
    ("concrete", "Тёмный бетон полигона.", "Тяжёлый строительный блок (180 кг), из него сделан пол полигона. Shift + колесо — форма."),
    ("concrete_line", "Бетон со светлой разметкой.", "Как бетон, но светлый — для разметки дорог и площадок. Shift + колесо — форма."),
    ("stone", "Камень.", "Строительный блок 150 кг. Под водой тонет. Shift + колесо — форма."),
    ("planks", "Тёмные доски: лёгкие и плавучие.", "40 кг, держатся на воде (подъём 1000 кг на блок): из досок строят плоты и корпуса лодок. Shift + колесо — форма."),
    ("steel_block", "Клёпаная сталь: тяжёлая и прочная.", "200 кг — хороший кузов и балласт: под водой тонет. Shift + колесо — плиты, ступеньки, скосы и углы из стали."),
    ("steel_frame", "Открытая стальная рама.", "60 кг, видно насквозь. Под водой держится (как пустой отсек: подъём 800 кг). Shift + колесо — форма."),
    ("steel_casing", "Стальной корпус; надевается на вал.", "Строительный блок. ПКМ корпусом по валу или трубе надевает кожух (вал в кожухе / труба в кожухе); Shift + ПКМ ключом — снять."),
    ("copper_casing", "Медный корпус; надевается на трубу.", "Строительный блок. ПКМ корпусом по трубе или валу — кожух на них; Shift + ПКМ ключом — снять."),
    ("glass", "Стекло: прозрачное, держится на воде.", "Соседнее стекло не рисует внутренних граней. Под водой даёт подъём 1000 кг (герметичный отсек). Shift + колесо — форма."),
    ("sliding_door", "Раздвижная дверь в два блока.", "Верх ставится сам. ПКМ — открыть / закрыть; сигнал логики рядом (рычаг, провод, кнопка) открывает, пока он держится. Открытая дверь пропускает."),
    ("steel_slope_half_low", "Нижняя половина скоса 27°.", "С верхней половиной даёт ровный скос 1 блок подъёма на 2 блока длины. Низкая сторона — к игроку."),
    ("steel_slope_half_high", "Верхняя половина скоса 27°.", "Ставится за нижней: вместе — ровный скос ≈27°."),
    ("steel_slope_q1", "Скос 14°, часть 1 из 4.", "Четыре части подряд дают пологий скос: 1 блок подъёма на 4 блока. Удобно для машин."),
    ("steel_slope_q2", "Скос 14°, часть 2 из 4.", "Вторая часть пологого скоса."),
    ("steel_slope_q3", "Скос 14°, часть 3 из 4.", "Третья часть пологого скоса."),
    ("steel_slope_q4", "Скос 14°, часть 4 из 4.", "Последняя часть пологого скоса."),
    // ---- mechanisms
    ("creative_motor", "Вечный мотор: даёт вращение.", "Выход — грань, куда смотрит. Ключом: скорость 0–256 об/мин, направление и мощность (по умолчанию 16 384 SU). Если сеть просит больше мощности — замедляется, при сильной перегрузке стоит."),
    ("diesel_engine", "Дизель: вращение за топливо.", "Сжигает 10 mB/с дизеля из своей трубной сети (труба с любой стороны, кроме выхода спереди). Нужен воздух: над ним пусто и не под водой. Мощность 2048 SU; при перегрузке глохнет с чёрным дымом и заводится, когда сбросишь газ или включишь пониженную передачу."),
    ("flywheel", "Маховик: копит энергию.", "Тяжёлый диск на валу. Из запаса мощности заряжается и при перегрузке отдаёт до 1000 SU на 2 секунды: старт тяжёлой машины, кочки."),
    ("shaft", "Вал: передаёт вращение по оси.", "Ставится по оси грани. Нагрузка 0,5 SU на 32 об/мин. Корпусом можно надеть кожух. Два вала одной оси соединяются механической лентой."),
    ("cased_shaft", "Вал в стальном кожухе.", "Работает как вал. Shift + ПКМ ключом снимает кожух."),
    ("cogwheel", "Шестерня: передаёт вращение вбок.", "Соседние шестерни одной оси крутятся навстречу (−1). С большой — по диагонали, вдвое быстрее. Вдоль оси работает как вал. Цепь соединяет шестерни на расстоянии."),
    ("large_cogwheel", "Большая шестерня: вдвое медленнее.", "С малой цепляется по диагонали (малая → большая — вдвое медленнее и вдвое меньше нагрузки), с большой — через клетку. Вплотную к малой не ставится."),
    ("gearbox", "Коробка передач: поворот на 90°.", "Четыре выхода вокруг оси; насквозь — обратное вращение. Вдоль оси не передаёт."),
    ("vertical_gearbox", "Вертикальная коробка передач.", "Как коробка передач, но её выходы — вверх, вниз, влево и вправо (ось — от игрока при установке)."),
    ("clutch", "Муфта: размыкает вал по сигналу.", "Вал, который разрывает вращение, пока на неё приходит сигнал (пульт, провод, рычаг, логика)."),
    ("gearshift", "Реверс: обратное вращение по сигналу.", "Вал; пока есть сигнал, сторона к −оси крутится в обратную сторону."),
    ("speed_controller", "Регулятор скорости.", "Вход сзади, выход спереди со своей скоростью. Сигнал «+» ведёт к «скорости по сигналу», «−» — к обратной: при скорости 0 это педаль газа. Делит мощность и нагрузку с сетью на входе. Низкая скорость по сигналу — пониженная передача."),
    ("mechanical_bearing", "Подшипник: крутит приклеенную платформу.", "Всё, что приклеено к блоку на его лицевой грани, становится телом на шарнире и крутится со скоростью вала сзади. Сигнал держит «Угол фиксации». В мире и на машинах (кран)."),
    ("mechanical_piston", "Поршень: выдвигает приклеенное.", "Один блок за оборот вала сзади, до «Хода» (1–16). Обратное вращение втягивает. На целом блоке группа становится блоками, за ней — шток."),
    ("fluid_tank", "Цистерна на 16 000 mB.", "Рядом стоящие объединяются в линию 1×N или колонну 1×1/2×2/3×3; жидкость оседает вниз, уровень виден. Режим «Балласт»: набирает забортную воду помпой. Пустая держится на воде."),
    ("creative_tank", "Бесконечный бак воды или дизеля.", "Источник для своей трубной сети: никогда не пустеет. Ключом — жидкость. Для стендов и испытаний."),
    ("fluid_pipe", "Труба: соединяет жидкостные блоки.", "Соединяется со всеми соседними цистернами, трубами, портами, двигателями. В одной сети порт сливает в цистерны, двигатель берёт топливо сам; между сетями — помпа."),
    ("cased_pipe", "Труба в медном кожухе.", "Работает как труба. Shift + ПКМ ключом снимает кожух."),
    ("mechanical_pump", "Помпа: перекачивает жидкость.", "Крутится как шестерня (от соседней шестерни сбоку). Переносит жидкость из сети сзади в сеть спереди: |об/мин| × 8 mB/с; ключом — направление. Конец, открытый в воду, наполняет балласт. Нагрузка 12 SU."),
    ("track_sprocket", "Ведущая звёздочка гусеницы.", "Ставится как колесо; крутится от вала сзади и ведёт весь ряд катков рядом. Лента гусеницы натягивается сама."),
    ("track_roller", "Опорный каток гусеницы.", "Ставится в ряд со звёздочкой (та же ось). Каждый каток опирается своей пружиной: устойчиво на кочках."),
    ("suspension", "Подвеска колеса.", "Держит колесо на своей оси, пружинит (ключом — жёсткость) и рулит по сигналу (ключом — угол)."),
    ("wheel", "Колесо.", "Ставится на подвеску. Крутится от сети; на физической машине тянет по земле. Ведущие колёса на подъёме нагружают двигатель."),
    ("chain", "Цепь между шестернями.", "ЛКМ по шестерне, затем по следующей (та же ось и плоскость, до 16 блоков, любой угол), и дальше по цепочке. Где щёлкнуть шестерню — сверху или снизу — так цепь её обойдёт: по одну сторону — одинаковое вращение, по разные — обратное. ПКМ по шестерне — снять."),
    ("mechanical_belt", "Механическая лента между валами.", "ЛКМ по валу, затем по другому валу той же оси: прямо, вертикально или под 45°, до 20 блоков. Шкивы крутятся одинаково; ровная и наклонная лента везёт игрока и тела."),
    // ---- control
    ("seat", "Сиденье: сесть и управлять.", "ПКМ — сесть, Shift — встать. Пульты рядом (3,5 блока) читают клавиатуру."),
    ("control_panel", "Пульт: клавиши → датчики.", "Работает, когда игрок сидит рядом. Связать с датчиком: ЛКМ ключом по пульту, затем по датчику."),
    ("sensor", "Датчик: сигнал пульта блоку.", "Ставится на блок, которым управляет. Ключом — клавиши «+» и «−». Подходит для подвески, муфты, реверса, регулятора, фары, подшипника, радиопередатчика."),
    ("telemetry_sensor", "Датчик телеметрии.", "Читает блок, на котором стоит: спидометр — км/ч, подвеска — угол, двигатель или мотор — загрузка %, цистерна — заполнение %, остальное — об/мин. ЛКМ ключом по датчику, затем по экрану — связь."),
    ("speedometer", "Спидометр машины.", "Измеряет скорость физической машины (км/ч); читается датчиком телеметрии или пороговым датчиком."),
    ("mechanical_display", "Механический экран: цифры или стрелка.", "Показывает значение связанного датчика телеметрии. Работает, пока его крутит шестерня или вал сбоку. Ключом — вид и максимум шкалы."),
    ("headlight", "Фара.", "Светит вдоль грани. Каждое нажатие клавиши на датчике (или импульс логики) включает или выключает."),
    ("fluid_port", "Заливной порт.", "ПКМ ведром — +1000 mB в трубную сеть (дизель или вода)."),
    ("physics_toggle", "Переключатель физики.", "ПКМ: он и всё приклеенное к нему становится одним физическим телом (машина), ещё раз — обратно в блоки."),
    // ---- logic
    ("wire", "Провод: ведёт сигнал.", "Кладётся на любую грань, несколько на один блок. Один цвет в соседних клетках — одна линия (и через ребро блока), разные цвета не соединяются. Shift + колесо — цвет новых, ЛКМ ключом — перекрасить."),
    ("button", "Кнопка: короткий импульс.", "ПКМ — сигнал на 0,8 с всем соседним блокам."),
    ("lever", "Рычаг: вкл / выкл.", "ПКМ переключает; включённый питает все соседние блоки."),
    ("timer_block", "Таймер: импульс по расписанию.", "Импульс 0,3 с каждые «Интервал» секунд (0,5–60). Стрелка на циферблате показывает время."),
    ("pulse_generator", "Генератор импульсов.", "Из включения сигнала на входе делает короткий импульс вперёд."),
    ("logic_gate", "Логический элемент: И, ИЛИ, НЕ, RS.", "Входы слева, справа и сзади, выход спереди (по стрелке), через кадр. RS-триггер: левый включает и запоминает, правый сбрасывает."),
    ("flasher_light", "Мигалка.", "Вспыхивает на импульс и мигает, пока сигнал держится."),
    ("lamp", "Лампа: светит при сигнале.", "Ровный тёплый свет, пока на неё приходит сигнал."),
    ("threshold_sensor", "Пороговый датчик: механика → логика.", "Читает блок, как датчик телеметрии (скорость, обороты, угол, заполнение бака, загрузку двигателя), и даёт сигнал соседям, пока значение не меньше (или не больше) порога. Пример: «бак полон → выключить помпу»."),
    ("radio_transmitter", "Радиопередатчик.", "Пока на него приходит сигнал (логика или датчик пульта), включён его канал (1–16) — для всех приёмников этого канала где угодно."),
    ("radio_receiver", "Радиоприёмник.", "Даёт сигнал соседям, пока включён его канал. Без проводов: ворота с пульта машины, свет на другом конце полигона."),
    // ---- tools
    ("wrench", "Гаечный ключ.", "ПКМ — повернуть блок; ЛКМ — настройки блока, связь пульта с датчиком и телеметрии с экраном, перекраска провода; Shift + ПКМ — снять кожух."),
    ("glue", "Клей: склеивает объём.", "ЛКМ — первый угол, ЛКМ — второй: всё внутри склеено. ПКМ — снять. Склеенное становится одним телом через переключатель физики, переезжает с подшипником и поршнем."),
    ("gravity_gun", "Гравипушка.", "ПКМ — притянуть и держать тело (до 1,5 т), ЛКМ — толкнуть."),
    ("physgun", "Физпушка.", "Удерживая ЛКМ — вести тело за прицелом; колесо — дальше/ближе; E + мышь — вращать; ПКМ — заморозить; R — разморозить."),
    ("blueprint", "Чертёж: копия постройки.", "ЛКМ по блоку — скопировать склеенную группу; голограмма показывает место, R — поворот, ПКМ — вставить. Консоль: save / load / blueprints."),
    ("bucket_diesel", "Ведро дизеля (не кончается).", "ПКМ по заливному порту — +1000 mB дизеля."),
    ("bucket_water", "Ведро воды (не кончается).", "ПКМ по заливному порту — +1000 mB воды."),
    ("engineer_goggles", "Инженерные очки: данные блоков.", "Наденьте в слот «Голова» (Shift + щелчок). У прицела — обороты, нагрузка и мощность, жидкость, двигатель, заряд маховика, сигналы блока."),
]
